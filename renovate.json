{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "prHourlyLimit": 0,
  "prCreation": "immediate",
  "dependencyDashboard": true,

  "packageRules": [
    {
      "description": "Group infrastructure dependencies",
      "matchFileNames": ["infrastructure/**"],
      "groupName": "infrastructure"
    },
    {
      "description": "Group k8s dependencies",
      "matchFileNames": ["k8s/**"],
      "groupName": "k8s"
    }
  ]
}
